	local success, response = pcall(function()
		return http_request({
			Url = FIREBASE_URL .. "tradebooth_servers/" .. jobId .. ".json" .. (FIREBASE_SECRET ~= "" and "?auth=" .. FIREBASE_SECRET or ""),
			Method = "PUT",
			Headers = {
				["Content-Type"] = "application/json"
			},
			Body = game.HttpService:JSONEncode(data)
		})
	end)

