					ClearTextOnFocus = true,
					ZIndex = 11,
					Parent = DropList,
				})
				AddCorner(SearchBox, 5)

				-- ScrollingFrame - תוקן!
				local Scrolling = Create("ScrollingFrame", {
					Size = UDim2.new(1, -8, 1, -40),
					Position = UDim2.new(0, 4, 0, 36),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					ScrollBarThickness = 4,
					ScrollBarImageColor3 = Theme.Accent,
					ScrollBarImageTransparency = 0.3,
					AutomaticCanvasSize = Enum.AutomaticSize.Y,  -- זה הפתרון העיקרי
					CanvasSize = UDim2.new(0, 0, 0, 0),
					ZIndex = 11,
					Parent = DropList,
				})
				AddListLayout(Scrolling, 2)
				AddPadding(Scrolling, 4, 4, 4, 4)

				local function RefreshList()
					for _, child in pairs(Scrolling:GetChildren()) do
						if child:IsA("TextButton") then
							child:Destroy()
						end
					end

					for _, opt in ipairs(filteredOptions) do
						local Item = Create("TextButton", {
							Size = UDim2.new(1, 0, 0, 28),
							BackgroundColor3 = opt == dSelected and Theme.Accent or Theme.DropdownItem,
							Text = opt,
							TextColor3 = opt == dSelected and Theme.TextPrimary or Theme.TextSecondary,
							TextSize = 12,
							Font = Fonts.Body,
							BorderSizePixel = 0,
							ZIndex = 12,
							Parent = Scrolling,
							TextXAlignment = Enum.TextXAlignment.Left,
						})
						AddCorner(Item, 5)

						Item.MouseButton1Click:Connect(function()
							dSelected = opt
							SelectedLabel.Text = dSelected
							RefreshList()
							dCallback(dSelected)
						end)

						Item.MouseEnter:Connect(function()
							if opt ~= dSelected then
								Tween(Item, {BackgroundColor3 = Theme.Border}, 0.1)
							end
						end)

						Item.MouseLeave:Connect(function()
							if opt ~= dSelected then
								Tween(Item, {BackgroundColor3 = Theme.DropdownItem}, 0.1)
							end
						end)
					end
				end

				local function FilterOptions()
					local query = SearchBox.Text:lower()
					filteredOptions = {}

					for _, opt in ipairs(dOptions) do
						if query == "" or opt:lower():find(query) then
							table.insert(filteredOptions, opt)
						end
					end

					RefreshList()
				end

				SearchBox:GetPropertyChangedSignal("Text"):Connect(FilterOptions)

				local DropBtn = Create("TextButton", {
					Size = UDim2.new(1, 0, 1, 0),
					BackgroundTransparency = 1,
					Text = "",
					ZIndex = 7,
					Parent = DropFrame,
				})

				DropBtn.MouseButton1Click:Connect(function()
					dOpen = not dOpen
					if dOpen then
						SearchBox.Text = ""
						FilterOptions()
					end

					local itemCount = #filteredOptions
					local targetH = dOpen and math.min(itemCount * 30 + 52, 220) or 0

					DropList.Visible = dOpen
					Tween(DropList, {Size = UDim2.new(1, 0, 0, targetH)}, 0.2, Enum.EasingStyle.Quart)
					Tween(Arrow, {Rotation = dOpen and 180 or 0}, 0.2)
					Tween(DropFrame, {BackgroundColor3 = dOpen and Theme.Border or Theme.SurfaceAlt}, 0.15)
				end)

				RefreshList()

				local Dropdown = {Frame = DropFrame}

				function Dropdown:Set(val)
					if table.find(dOptions, val) then
						dSelected = val
						SelectedLabel.Text = val
						RefreshList()
						dCallback(val)
					end
				end

				function Dropdown:Get()
					return dSelected
				end

				function Dropdown:SetOptions(opts)
					dOptions = opts or {}
					if not table.find(dOptions, dSelected) then
						dSelected = dOptions[1] or "Select..."
					end
					SelectedLabel.Text = dSelected
					FilterOptions()
				end

				return {DropFrame,DropBtn}
			end

