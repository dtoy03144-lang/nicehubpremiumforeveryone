					BackgroundColor3 = Theme.InputBg,
					Text = kBound.Name,
					TextColor3 = Theme.Accent,
					TextSize = 11,
					Font = Fonts.Mono,
					BorderSizePixel = 0,
					Parent = KBFrame,
				})
				AddCorner(KeyBtn, 5)
				AddStroke(KeyBtn, Theme.Border, 1)

				KeyBtn.MouseButton1Click:Connect(function()
					kListening = not kListening
					if kListening then
						KeyBtn.Text = "..."
						KeyBtn.TextColor3 = Theme.Warning
						Tween(KeyBtn, { BackgroundColor3 = Theme.SurfaceAlt }, 0.1)
					else
						KeyBtn.Text = kBound.Name
						KeyBtn.TextColor3 = Theme.Accent
						Tween(KeyBtn, { BackgroundColor3 = Theme.InputBg }, 0.1)
					end
				end)

				UserInputService.InputBegan:Connect(function(input, gpe)
					if kListening and not gpe and input.UserInputType == Enum.UserInputType.Keyboard then
						kBound = input.KeyCode
						KeyBtn.Text = kBound.Name
						KeyBtn.TextColor3 = Theme.Accent
						Tween(KeyBtn, { BackgroundColor3 = Theme.InputBg }, 0.1)
						kListening = false
					elseif not kListening and input.KeyCode == kBound then
						kCallback(kBound)
					end
				end)

				KBFrame.MouseEnter:Connect(function()
					Tween(KBFrame, { BackgroundColor3 = Theme.Border }, 0.15)
				end)
				KBFrame.MouseLeave:Connect(function()
					Tween(KBFrame, { BackgroundColor3 = Theme.SurfaceAlt }, 0.15)
				end)

				local KB = { Frame = KBFrame }
				function KB:Set(key)
					kBound = key
					KeyBtn.Text = key.Name
				end
				function KB:Get()
					return kBound
				end
				return KB
			end

			table.insert(Section, Section)
			return Section
		end

		return Tab
	end

	function Window:SelectTab(tab)
		for _, t in pairs(Window.Tabs) do
			t.Page.Visible = false
			Tween(t.Button, { BackgroundColor3 = Theme.TabInactive }, 0.15)
			Tween(t.Label, { TextColor3 = Theme.TextSecondary }, 0.15)
			t.ActiveBar.Visible = false
		end
		tab.Page.Visible = true
		Tween(tab.Button, { BackgroundColor3 = Theme.TabActive }, 0.15)
		Tween(tab.Label, { TextColor3 = Theme.TextPrimary }, 0.15)
		tab.ActiveBar.Visible = true
		Window.ActiveTab = tab
	end

	Tween(MainFrame, { Size = size }, 0.35, Enum.EasingStyle.Back)

	return Window
end
