local function GetBoothListings(boothId)
	local boothData = data.Booths[boothId]
	if not boothData or not boothData.Owner then
		return nil 
	end

	local ownerId = boothData.Owner
	local playerData = data.Players[ownerId]

	if playerData and playerData.Listings then
		return playerData.Listings, playerData.Items
	end
	return nil
end
