			function Section:AddSlider(cfg)
				cfg = cfg or {}
				local sLabel    = cfg.Label or "Slider"
				local sMin      = cfg.Min or 0
				local sMax      = cfg.Max or 100
				local sDefault  = cfg.Default or sMin
				local sSuffix   = cfg.Suffix or ""
				local sCallback = cfg.Callback or function() end
				local sValue    = math.clamp(sDefault, sMin, sMax)

				local SliderFrame = Create("Frame", {
					Name = sLabel .. "Slider",
					Size = UDim2.new(1, 0, 0, 52),
					BackgroundColor3 = Theme.SurfaceAlt,
					BorderSizePixel = 0,
					Parent = SectionFrame,
				})
				AddCorner(SliderFrame, 6)
				AddPadding(SliderFrame, 8, 12, 8, 12)

				local TopRow = Create("Frame", {
					Size = UDim2.new(1, 0, 0, 18),
					BackgroundTransparency = 1,
					Parent = SliderFrame,
				})

				Create("TextLabel", {
					Size = UDim2.new(0.7, 0, 1, 0),
					BackgroundTransparency = 1,
					Text = sLabel,
					TextColor3 = Theme.TextPrimary,
					TextSize = 13,
					Font = Fonts.Subtitle,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = TopRow,
				})

				local ValueLabel = Create("TextLabel", {
					Size = UDim2.new(0.3, 0, 1, 0),
					Position = UDim2.new(0.7, 0, 0, 0),
					BackgroundTransparency = 1,
					Text = tostring(sValue) .. sSuffix,
					TextColor3 = Theme.Accent,
					TextSize = 12,
					Font = Fonts.Mono,
					TextXAlignment = Enum.TextXAlignment.Right,
					Parent = TopRow,
				})

				local Track = Create("Frame", {
					Name = "Track",
					Size = UDim2.new(1, 0, 0, 6),
					Position = UDim2.new(0, 0, 0, 30),
					BackgroundColor3 = Theme.SliderTrack,
					BorderSizePixel = 0,
					Parent = SliderFrame,
				})
				AddCorner(Track, 3)

				local Fill = Create("Frame", {
					Name = "Fill",
					Size = UDim2.new((sValue - sMin) / (sMax - sMin), 0, 1, 0),
					BackgroundColor3 = Theme.SliderFill,
					BorderSizePixel = 0,
					Parent = Track,
				})
				AddCorner(Fill, 3)
				GradientFrame(Fill, Theme.Accent, Theme.AccentGlow, 0)

				local Thumb = Create("Frame", {
					Name = "Thumb",
					Size = UDim2.new(0, 14, 0, 14),
					Position = UDim2.new((sValue - sMin) / (sMax - sMin), -7, 0.5, -7),
					BackgroundColor3 = Theme.TextPrimary,
					BorderSizePixel = 0,
					ZIndex = 3,
					Parent = Track,
				})
				AddCorner(Thumb, 7)

				local dragging = false
				local function UpdateSlider(input)
					local rel   = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
					sValue      = sMin + (sMax - sMin) * rel
					ValueLabel.Text = tostring(sValue) .. sSuffix
					Tween(Fill, { Size = UDim2.new(rel, 0, 1, 0) }, 0.05)
					Tween(Thumb, { Position = UDim2.new(rel, -7, 0.5, -7) }, 0.05)
					sCallback(sValue)
				end

				Track.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						dragging = true
						UpdateSlider(input)
					end
				end)
				UserInputService.InputChanged:Connect(function(input)
					if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
						UpdateSlider(input)
					end
				end)
				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						dragging = false
					end
				end)

				SliderFrame.MouseEnter:Connect(function()
					Tween(SliderFrame, { BackgroundColor3 = Theme.Border }, 0.15)
				end)
				SliderFrame.MouseLeave:Connect(function()
					Tween(SliderFrame, { BackgroundColor3 = Theme.SurfaceAlt }, 0.15)
				end)

				local Slider = { Frame = SliderFrame }
				function Slider:Set(val)
					sValue = math.clamp(val, sMin, sMax)
					local rel = (sValue - sMin) / (sMax - sMin)
					ValueLabel.Text = tostring(sValue) .. sSuffix
					Tween(Fill, { Size = UDim2.new(rel, 0, 1, 0) }, 0.1)
					Tween(Thumb, { Position = UDim2.new(rel, -7, 0.5, -7) }, 0.1)
					sCallback(sValue)
				end
				function Slider:Get()
					return sValue
				end
				return Slider
			end
